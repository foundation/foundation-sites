{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundationcss.com/yeti/schema/tokens.json",
  "title": "Yeti tokens catalogue",
  "description": "Every public --yeti-* custom property, with its group, default, and description. Internal --_yeti-* tokens are not listed.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["name", "group", "public", "default", "description"],
    "properties": {
      "name": { "type": "string", "pattern": "^--yeti-[a-z0-9-]+$" },
      "group": { "enum": ["scale", "space", "radius", "width", "text", "font", "hue", "color", "motion", "layout", "border", "weight", "shadow", "control", "button", "badge", "card", "field", "table", "seam", "nav", "breadcrumbs", "pagination", "alert", "progress", "spinner"] },
      "public": { "const": true },
      "declared": { "type": "boolean", "description": "false for override-only inputs Yeti never declares (--yeti-base, --yeti-ratio)." },
      "default": { "type": "string" },
      "description": { "type": "string" }
    }
  }
}
